# Copy to `.env.docker` and pass to Compose:
#   docker compose --env-file .env.docker up -d --build
#
# Do not commit `.env.docker` (it holds secrets).

# Required — use a long random password for anything beyond a throwaway lab.
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# Host ports for the Compose TLS proxy (default HTTPS quick-start).
TASKMESH_HTTP_PORT=80
TASKMESH_HTTPS_PORT=443

# Session cookies: default Compose path terminates TLS → keep true.
# For the HTTP-only lab override (compose.http-lab.yaml), set false (or rely on that file’s default).
COOKIE_SECURE=true

# Express trust proxy hop count (required behind the Compose nginx proxy / bare-metal nginx).
TRUST_PROXY=1

# Optional — HTTP lab published port when using compose.http-lab.yaml
# TASKMESH_PORT=3000

# Optional — Assistant panel (leave blank to disable chat backend)
# OPENAI_API_KEY=sk-...
# ASSISTANT_DEFAULT_PROVIDER=openai
# ASSISTANT_DEFAULT_MODEL=gpt-4.1-mini
