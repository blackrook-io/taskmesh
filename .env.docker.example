# Copy to `.env.docker` and pass to Compose:
#   docker compose --env-file .env.docker up -d --build
#
# Do not commit `.env.docker` (it holds secrets).

# Required — use a long random password for anything beyond a throwaway lab.
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# Host port published for the TaskMesh UI + API (container always listens on 3000).
TASKMESH_PORT=3000

# Session cookies: false for plain HTTP (default Compose desktop). Set true only behind HTTPS.
COOKIE_SECURE=false

# Optional — Assistant panel (leave blank to disable chat backend)
# OPENAI_API_KEY=sk-...
# ASSISTANT_DEFAULT_PROVIDER=openai
# ASSISTANT_DEFAULT_MODEL=gpt-4.1-mini
