# PostgreSQL connection (see INSTALL.md for Ubuntu bare-metal or container setup)
DATABASE_URL=postgresql://taskmesh:your-secure-password@127.0.0.1:5432/taskmesh
# Container Compose sets DATABASE_URL to host `db` automatically — prefer `.env.docker`
# (see `.env.docker.example`) rather than this file when using `compose.yaml`.

# Bind Express to loopback only on bare metal; nginx (or SSH tunnel) reaches it here.
# In Docker/Compose the image defaults to HOST=0.0.0.0 so the internal network / proxy works.
HOST=127.0.0.1
# PROD API port (systemd `npm start` / dist). nginx :443 → this port.
PORT=3000
# Session Set-Cookie Secure flag. Default: on when NODE_ENV=production.
# Override with COOKIE_SECURE=true|false. Compose TLS path defaults to true.
# COOKIE_SECURE=true
# Express trust proxy (X-Forwarded-*). Explicit — not inferred from NODE_ENV.
# Behind nginx (bare metal or Compose proxy): TRUST_PROXY=1
# Direct exposure without a proxy: TRUST_PROXY=false (or omit).
TRUST_PROXY=1

# DEV API port used by `npm run dev` / `dev:web` (overrides PORT for those scripts).
# Vite on :5173 proxies /api → 127.0.0.1:$DEV_API_PORT so PROD and DEV can run together.
# DEV_API_PORT=3001
# Instance branding (optional). Default: prod when PORT=3000 or unset, otherwise dev.
# DEV (`npm run dev` on :3001 + Vite :5173) uses a yellow favicon and yellow default
# theme overlay without writing system_properties (shared DB with PROD).
# TASKMESH_INSTANCE=dev
# TASKMESH_INSTANCE=prod

# Uploaded images (optional; default ./data/uploads)
# UPLOAD_DIR=/var/lib/taskmesh/uploads

# Max image upload size in bytes (default 5242880 = 5 MiB)
# UPLOAD_MAX_BYTES=5242880
# Max binary document upload (EPUB + PDF); default 104857600 = 100 MiB
# UPLOAD_MAX_BYTES_BINARY=104857600
# Legacy alias still honored when BINARY is unset
# UPLOAD_MAX_BYTES_EPUB=104857600
# Cumulative per-user upload storage quota (default 5368709120 = 5 GiB)
# UPLOAD_QUOTA_BYTES=5368709120

# Backups (optional; default ./data/backups)
# BACKUP_DIR=/var/lib/taskmesh/backups
# BACKUP_SCHEDULE_PATH=/srv/taskmesh/data/backup-schedule.json

# Last successful PRODUCTION deploy stamp (written by npm run deploy:prod)
# PROD_RELEASE_PATH=/srv/taskmesh/data/prod-release.json

# Assistant. OPENAI_API_KEY is deprecated: on first boot it enables the OpenAI
# provider plugin and remains that plugin's key until instance keys exist.
# ASSISTANT_DEFAULT_MODEL is the model seeded into that plugin config.
# OPENAI_API_KEY=sk-...
# ASSISTANT_DEFAULT_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY is optional. It is not stored and does not enable the plugin.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY is optional. It is not stored and does not enable the plugin.
# GEMINI_API_KEY=...
# AZURE_OPENAI_API_KEY is optional. It is not stored and does not enable the plugin.
# AZURE_OPENAI_API_KEY=...
# AI_CREDENTIALS_KEY encrypts instance and per-user provider keys at rest.
# Separate from OAUTH_CREDENTIALS_KEY and MFA_TOTP_KEY.
# Minimum 32 characters when set (startup refuses shorter keys). e.g. openssl rand -base64 48
# AI_CREDENTIALS_KEY=
# Set only while rotating. See docs/AI_CREDENTIALS.md. Remove after a successful --apply and restart.
# AI_CREDENTIALS_KEY_NEXT=

# OAuth / OIDC (T0111) — encrypts Google/Apple/GitHub provider secrets at rest.
# Required before enabling any provider in Administration → OAuth.
# Minimum 32 characters when set (startup refuses shorter keys). e.g. openssl rand -base64 48
# OAUTH_CREDENTIALS_KEY=
# Optional public origin for redirect_uri when behind unusual proxies (no trailing slash).
# OAUTH_PUBLIC_BASE_URL=https://taskmesh.example.com

# MFA TOTP (T0139) — encrypts authenticator secrets at rest.
# Required before users can enroll MFA (Profile). Separate from OAUTH_CREDENTIALS_KEY.
# Minimum 32 characters when set (startup refuses shorter keys). e.g. openssl rand -base64 48
# MFA_TOTP_KEY=

# Update check (T0132) — latest stable GitHub Release vs the running version.
# Shown only to Administrators. Public repos work without a token (60 req/hour).
# GITHUB_REPO=blackrook-io/taskmesh
# GITHUB_TOKEN=

# Rate limits (T0145) — DEV/TEST only. Ignored when NODE_ENV=production (startup warns).
# RATE_LIMIT_DISABLE=1
# API request log retention in days (default 90). Pruned in-process every 6h.
# API_REQUEST_LOG_RETENTION_DAYS=90
